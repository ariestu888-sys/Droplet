{
  "name": "droplet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev -w @droplet/api\" \"npm:dev -w @droplet/web\"",
    "dev:api": "npm run dev -w @droplet/api",
    "dev:web": "npm run dev -w @droplet/web",
    "build": "npm run build -w @droplet/api && npm run build -w @droplet/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
