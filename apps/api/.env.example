PORT=4000
# From Supabase: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3001
# The website's address, for links in emails (e.g. invitations).
PUBLIC_SITE_URL=http://localhost:3001

# Optional: send invitation emails through Resend (https://resend.com).
# Without a key, invitations still work: organizers copy and share the link.
# RESEND_API_KEY=re_...
# The sender. Resend's test sender (below) only delivers to your own Resend
# account's email; verify your domain in Resend to email anyone.
# EMAIL_FROM=Droplet <onboarding@resend.dev>
