# Copy to .env.local and fill in from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the site's public address, used in sign-up and Google redirect links.
# Leave unset locally; set it in production, e.g. https://droplet.example.com
# NEXT_PUBLIC_SITE_URL=

# The Droplet API (apps/api). All app data goes through it.
NEXT_PUBLIC_API_URL=http://localhost:4000
